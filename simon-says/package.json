{
	"name": "simon-says",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "npm run build && gh-pages -d dist -e simon-says",
		"stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
		"lint": "eslint --fix",
		"format": "prettier --write \"./src/**/*.{js,css,scss}\" --ignore-path ./.prettierignore",
		"check": "npm run stylelint:fix && npm run lint && npm run format",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{css,scss}": "npm run stylelint:fix",
		"*.{js,jsx,ts,tsx}": "npm run lint",
		"*.{js,jsx,ts,tsx,json,css,scss,md}": "npm run format"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.19.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.1",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"stylelint": "^16.12.0",
		"stylelint-config-standard": "^36.0.1",
		"vite": "^6.0.5"
	}
}
